<Window x:Class="SweetTailor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sweet Tailor — Simulateur Mobile Haute Fidélité"
        Height="890" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="#DCDEEE"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI, Inter, -apple-system, sans-serif">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: SCREEN DIRECTORY & CONTROLS -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E8E9F3" BorderThickness="0,0,1,0" Padding="18">
            <DockPanel>
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="14" Background="#26306B" Margin="0,0,12,0">
                            <!-- Logo S with gold tape thread and rose eye -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="S" Foreground="#F4C95D" FontSize="26" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sweet Tailor" FontSize="20" FontWeight="ExtraBold" Foreground="#26306B" />
                            <TextBlock Text="Chaque mesure compte." FontSize="11.5" Foreground="#6B7094" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="ÉCRANS DE LA MAQUETTE FIGMA" FontSize="10.5" FontWeight="ExtraBold" Foreground="#9A9EBD" Margin="0,18,0,6" />
                </StackPanel>

                <!-- Screen Selector List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ScreenButtonsList" Margin="0,0,6,0">
                        <!-- Group 1: Onboarding & Auth -->
                        <TextBlock Text="Démarrage &amp; Authentification" FontSize="11" FontWeight="Bold" Foreground="#B8325A" Margin="0,4,0,4" />
                        <Button Content="1 · Écran de lancement (Splash)" Tag="Splash" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="2 · Onboarding 1 (Mesures)" Tag="Onboarding1" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="3 · Onboarding 2 (Échéances)" Tag="Onboarding2" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="4 · Onboarding 3 (Catalogue)" Tag="Onboarding3" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="5 · Connexion" Tag="Login" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="6 · Mot de passe oublié" Tag="ForgotPassword" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="7 · Inscription (Validation)" Tag="Register" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />

                        <!-- Group 2: Clients -->
                        <TextBlock Text="Clients &amp; Fiches" FontSize="11" FontWeight="Bold" Foreground="#26306B" Margin="0,12,0,4" />
                        <Button Content="8 · Mes clients (Accueil)" Tag="Clients" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="9 · Clients : état vide" Tag="ClientsEmpty" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="10 · Clients : chargement" Tag="ClientsLoading" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="11 · Clients : erreur réseau" Tag="ClientsError" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="12 · Fiche client (Mesures)" Tag="ClientDetail" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="13 · Mesures détaillées (cm)" Tag="Measurements" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="21 · Nouveau client" Tag="ClientForm" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="22 · Fiche client (Commandes)" Tag="ClientOrders" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="23 · Fiche client (Notes)" Tag="ClientNotes" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />

                        <!-- Group 3: Commandes -->
                        <TextBlock Text="Commandes" FontSize="11" FontWeight="Bold" Foreground="#8A6A10" Margin="0,12,0,4" />
                        <Button Content="16 · Commandes &amp; Échéances" Tag="Orders" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="15 · Détail commande #0142" Tag="OrderDetail" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="14 · Nouvelle commande" Tag="NewOrder" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />

                        <!-- Group 4: Recherche & Catalogue -->
                        <TextBlock Text="Recherche &amp; Catalogue" FontSize="11" FontWeight="Bold" Foreground="#1E7A50" Margin="0,12,0,4" />
                        <Button Content="17 · Recherche (Résultats « Mba »)" Tag="Search" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="18 · Recherche : aucun résultat" Tag="SearchEmpty" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="19 · Catalogue de modèles" Tag="Catalog" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="20 · Détail d'un modèle" Tag="CatalogDetail" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="24 · Charte des composants" Tag="Components" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                        <Button Content="25 · Profil &amp; Atelier" Tag="Profile" Click="OnSelectScreen" Style="{DynamicResource ScreenBtnStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- RIGHT PANEL: PHONE FRAME (360 x 800 interior) -->
        <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Standalone Phone Shadow layer (zero blur on child elements!) -->
            <Border Width="378" Height="818"
                    CornerRadius="44"
                    Background="#14173A"
                    Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" Direction="270" ShadowDepth="12" Opacity="0.22" Color="#14173A" />
                </Border.Effect>
            </Border>

            <!-- Crisp Phone Chassis -->
            <Border Width="378" Height="818"
                    CornerRadius="44"
                    Background="#F6F5FA"
                    BorderBrush="#14173A"
                    BorderThickness="9"
                    SnapsToDevicePixels="True">
                <Grid ClipToBounds="True">
                    <!-- Top Notch -->
                    <Border Width="92" Height="24"
                            CornerRadius="12"
                            Background="#14173A"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Panel.ZIndex="10"
                            Margin="0,8,0,0" />

                    <!-- Status Bar (9:41, wifi, battery) -->
                    <Grid Height="44" VerticalAlignment="Top" Panel.ZIndex="9" Margin="26,0,26,0">
                        <TextBlock Text="9:41" FontSize="13" FontWeight="Bold" Foreground="#14173A" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6">
                            <!-- Signal Icon -->
                            <Path Data="M0,10 L3,10 L3,6 L0,6 Z M4,10 L7,10 L7,3 L4,3 Z M8,10 L11,10 L11,0 L8,0 Z" Fill="#14173A" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <!-- Battery Icon -->
                            <Border Width="18" Height="10" CornerRadius="3" BorderBrush="#14173A" BorderThickness="1.5" VerticalAlignment="Center">
                                <Border Width="12" Height="6" Background="#14173A" CornerRadius="1" HorizontalAlignment="Left" Margin="1" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Active Screen Viewport (360 x 800 interior) -->
                    <Grid Margin="0,44,0,0">
                        <!-- Dynamic Screen Content Container -->
                        <ContentControl x:Name="ScreenHost" />

                        <!-- Bottom Navigation Bar (Visible on mobile tabbed screens) -->
                        <Border x:Name="BottomNavBar"
                                Height="76"
                                Background="#FFFFFF"
                                BorderBrush="#E8E9F3"
                                BorderThickness="0,1,0,0"
                                VerticalAlignment="Bottom"
                                Visibility="Collapsed"
                                Panel.ZIndex="8">
                            <UniformGrid Columns="4" VerticalAlignment="Center" Margin="0,4,0,6">
                                <!-- Clients Tab -->
                                <Button x:Name="BtnNavClients" Click="OnNavClients" Style="{DynamicResource NavItemStyle}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path x:Name="NavClientsIcon"
                                              Data="M9,4.5 C10.93,4.5 12.5,6.07 12.5,8 C12.5,9.93 10.93,11.5 9,11.5 C7.07,11.5 5.5,9.93 5.5,8 C5.5,6.07 7.07,4.5 9,4.5 Z M2.5,20 C3.1,16.4 5.7,14.5 9,14.5 C12.3,14.5 14.9,16.4 15.5,20 M16,4.8 C17.3,5.5 18.2,6.9 18.2,8.5 C18.2,10.1 17.3,11.5 16,12.2 M18,14.8 C19.8,15.5 21,17.2 21.5,20"
                                              Stroke="#26306B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="NavClientsLabel" Text="Clients" FontSize="10.5" FontWeight="Bold" Foreground="#26306B" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Button>

                                <!-- Commandes Tab -->
                                <Button x:Name="BtnNavOrders" Click="OnNavOrders" Style="{DynamicResource NavItemStyle}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path x:Name="NavOrdersIcon"
                                              Data="M5,8 L19,8 L18,20 L6,20 Z M9,8 L9,6.5 C9,4.84 10.34,3.5 12,3.5 C13.66,3.5 15,4.84 15,6.5 L15,8"
                                              Stroke="#9A9EBD" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="NavOrdersLabel" Text="Commandes" FontSize="10.5" FontWeight="SemiBold" Foreground="#9A9EBD" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Button>

                                <!-- Catalogue Tab -->
                                <Button x:Name="BtnNavCatalog" Click="OnNavCatalog" Style="{DynamicResource NavItemStyle}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path x:Name="NavCatalogIcon"
                                              Data="M3.5,4.5 L20.5,4.5 C21.6,4.5 22.5,5.4 22.5,6.5 L22.5,17.5 C22.5,18.6 21.6,19.5 20.5,19.5 L3.5,19.5 C2.4,19.5 1.5,18.6 1.5,17.5 L1.5,6.5 C1.5,5.4 2.4,4.5 3.5,4.5 Z M9,8.4 C9.88,8.4 10.6,9.12 10.6,10 C10.6,10.88 9.88,11.6 9,11.6 C8.12,11.6 7.4,10.88 7.4,10 C7.4,9.12 8.12,8.4 9,8.4 Z M4,17 L9,12.5 L13,16 L16,13.5 L20,17"
                                              Stroke="#9A9EBD" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="NavCatalogLabel" Text="Catalogue" FontSize="10.5" FontWeight="SemiBold" Foreground="#9A9EBD" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Button>

                                <!-- Profil Tab -->
                                <Button x:Name="BtnNavProfile" Click="OnNavProfile" Style="{DynamicResource NavItemStyle}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path x:Name="NavProfileIcon"
                                              Data="M12,4.5 C14.2,4.5 16,6.3 16,8.5 C16,10.7 14.2,12.5 12,12.5 C9.8,12.5 8,10.7 8,8.5 C8,6.3 9.8,4.5 12,4.5 Z M4.5,20 C5.2,16 8.2,14 12,14 C15.8,14 18.8,16 19.5,20"
                                              Stroke="#9A9EBD" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="NavProfileLabel" Text="Profil" FontSize="10.5" FontWeight="SemiBold" Foreground="#9A9EBD" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <Window.Resources>
        <!-- Nav item style -->
        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar button style with smooth hover -->
        <Style x:Key="ScreenBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F6F5FA" />
            <Setter Property="Foreground" Value="#14173A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E4E5F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#D6D8EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
