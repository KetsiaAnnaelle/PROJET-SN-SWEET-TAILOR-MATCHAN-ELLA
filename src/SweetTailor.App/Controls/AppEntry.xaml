<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SweetTailor.App.Controls.AppEntry">
    <VerticalStackLayout Spacing="4">
        <!-- Input Container Box -->
        <Border x:Name="BorderBox"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="1"
                Stroke="{StaticResource Line}"
                BackgroundColor="{StaticResource White}"
                Padding="14, 6"
                HeightRequest="60">
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                <!-- Leading Icon -->
                <Path x:Name="LeadingIconPath"
                      Grid.Column="0"
                      WidthRequest="18"
                      HeightRequest="18"
                      Aspect="Uniform"
                      Margin="0, 0, 8, 0"
                      Fill="{StaticResource Muted}"
                      VerticalOptions="Center"
                      IsVisible="False" />

                <!-- Label + Entry Stack -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label x:Name="FieldLabel"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Muted}" />

                    <Entry x:Name="InputField"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Ink}"
                           PlaceholderColor="{StaticResource Muted}"
                           BackgroundColor="Transparent"
                           Margin="0, -2, 0, 0"
                           VerticalOptions="Center"
                           VerticalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Trailing Icon / Action (Check, Alert, Eye toggle) -->
                <Grid Grid.Column="2" VerticalOptions="Center" Margin="6, 0, 0, 0">
                    <!-- Password Eye Toggle Button -->
                    <ImageButton x:Name="EyeButton"
                                 WidthRequest="22"
                                 HeightRequest="22"
                                 Source="eye.png"
                                 BackgroundColor="Transparent"
                                 Clicked="OnTogglePassword"
                                 IsVisible="False" />

                    <!-- Status Icon (Valid check or Error alert) -->
                    <Path x:Name="StatusIcon"
                          WidthRequest="18"
                          HeightRequest="18"
                          Aspect="Uniform"
                          IsVisible="False" />
                </Grid>
            </Grid>
        </Border>

        <!-- Error / Helper Message -->
        <HorizontalStackLayout x:Name="MessageStack" Spacing="6" Margin="4, 0, 0, 0" IsVisible="False">
            <Path x:Name="MessageIcon"
                  WidthRequest="12"
                  HeightRequest="12"
                  Aspect="Uniform"
                  VerticalOptions="Center" />
            <Label x:Name="MessageText"
                   FontSize="11.5"
                   VerticalTextAlignment="Center" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>
