<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SweetTailor.App.Controls.SearchBox">
    <Border x:Name="SearchBorder"
            StrokeShape="RoundRectangle 14"
            StrokeThickness="1"
            Stroke="{StaticResource Line}"
            BackgroundColor="{StaticResource White}"
            HeightRequest="46"
            Padding="14, 0">
        <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
            <!-- Magnifying Glass Icon -->
            <Path x:Name="SearchIcon"
                  Grid.Column="0"
                  WidthRequest="16"
                  HeightRequest="16"
                  Aspect="Uniform"
                  Margin="0, 0, 10, 0"
                  Fill="{StaticResource Muted}"
                  VerticalOptions="Center"
                  Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />

            <!-- Input Entry -->
            <Entry x:Name="SearchInput"
                   Grid.Column="1"
                   FontSize="13.5"
                   TextColor="{StaticResource Ink}"
                   PlaceholderColor="{StaticResource Muted}"
                   BackgroundColor="Transparent"
                   HeightRequest="36"
                   VerticalOptions="Center" />

            <!-- Clear Button ✕ -->
            <ImageButton x:Name="ClearButton"
                         Grid.Column="2"
                         WidthRequest="20"
                         HeightRequest="20"
                         BackgroundColor="Transparent"
                         Clicked="OnClearClicked"
                         IsVisible="False"
                         VerticalOptions="Center">
                <ImageButton.Source>
                    <FontImageSource Glyph="✕" Color="{StaticResource Muted}" Size="14" />
                </ImageButton.Source>
            </ImageButton>
        </Grid>
    </Border>
</ContentView>
