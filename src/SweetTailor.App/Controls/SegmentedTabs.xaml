<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SweetTailor.App.Controls.SegmentedTabs">
    <Border StrokeShape="RoundRectangle 14"
            BackgroundColor="{StaticResource Mist}"
            StrokeThickness="0"
            Padding="4"
            HeightRequest="44">
        <Grid x:Name="TabsGrid" ColumnDefinitions="*, *, *" />
    </Border>
</ContentView>
