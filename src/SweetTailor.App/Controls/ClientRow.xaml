<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SweetTailor.App.Controls"
             x:Class="SweetTailor.App.Controls.ClientRow">
    <Border StrokeShape="RoundRectangle 18"
            StrokeThickness="1"
            Stroke="{StaticResource Line}"
            BackgroundColor="{StaticResource White}"
            Padding="14, 12"
            Margin="0, 0, 0, 10">
        <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
            <!-- Avatar Left -->
            <controls:AvatarInitials x:Name="Avatar"
                                     Grid.Column="0"
                                     Size="46"
                                     VerticalOptions="Center" />

            <!-- Client Info Middle -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="12, 0, 8, 0">
                <Label x:Name="NameLabel"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Ink}" />
                <Label x:Name="OrderDescLabel"
                       FontSize="12"
                       TextColor="{StaticResource Muted}" />
            </VerticalStackLayout>

            <!-- Status Pill Right -->
            <controls:StatusPill x:Name="StatusBadge"
                                 Grid.Column="2"
                                 VerticalOptions="Center"
                                 HorizontalOptions="End" />
        </Grid>
    </Border>
</ContentView>
