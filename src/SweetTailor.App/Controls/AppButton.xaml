<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SweetTailor.App.Controls.AppButton">
    <Border x:Name="ButtonBorder"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            HeightRequest="52"
            Padding="16, 0">
        <Grid HorizontalOptions="Center" VerticalOptions="Center">
            <!-- Normal Content -->
            <Label x:Name="ButtonLabel"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />

            <!-- Busy Content -->
            <HorizontalStackLayout x:Name="BusyStack" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False">
                <ActivityIndicator x:Name="BusyIndicator" IsRunning="True" WidthRequest="20" HeightRequest="20" Color="White" />
                <Label x:Name="BusyLabel" FontSize="15" FontAttributes="Bold" TextColor="White" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>
