<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SweetTailor.App.Controls"
             x:Class="SweetTailor.App.Controls.TapeMeasure">
    <Border BackgroundColor="#F4C95D"
            StrokeThickness="0"
            HeightRequest="{Binding Height, Source={RelativeSource AncestorType={x:Type local:TapeMeasure}}}">
        <GraphicsView x:Name="CanvasView"
                      HorizontalOptions="FillAndExpand"
                      VerticalOptions="FillAndExpand" />
    </Border>
</ContentView>
