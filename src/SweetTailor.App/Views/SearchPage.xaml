<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SweetTailor.App.Controls"
             xmlns:vm="clr-namespace:SweetTailor.Core.ViewModels;assembly=SweetTailor.Core"
             xmlns:models="clr-namespace:SweetTailor.Core.Models;assembly=SweetTailor.Core"
             x:Class="SweetTailor.App.Views.SearchPage"
             x:DataType="vm:SearchViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Chalk}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="0, 10, 0, 40">
            <!-- Search Topbar with SearchBox -->
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" Padding="20, 6, 20, 0">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 20"
                        Stroke="{StaticResource Line}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        WidthRequest="40"
                        HeightRequest="40"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconPathBack}"
                          Stroke="{StaticResource Ink}"
                          StrokeThickness="1.8"
                          WidthRequest="20"
                          HeightRequest="20"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <controls:SearchBox Grid.Column="1"
                                    Placeholder="Rechercher..."
                                    Text="{Binding Query, Mode=TwoWay}"
                                    SearchCommand="{Binding SearchCommand}"
                                    ClearCommand="{Binding ClearQueryCommand}" />
            </Grid>

            <!-- Recherches récentes (visible si Query est vide) -->
            <VerticalStackLayout Spacing="10" Padding="20, 4, 20, 0"
                                 IsVisible="{Binding Query.Length, Converter={StaticResource BoolInvert}, ConverterParameter=True}">
                <Label Text="Recherches récentes"
                       FontFamily="BricolageExtraBold"
                       FontSize="15"
                       TextColor="{StaticResource Muted}" />
                <HorizontalStackLayout Spacing="8">
                    <controls:FilterChip Text="Kaba" Tapped="OnRecentSearchClicked" />
                    <controls:FilterChip Text="Costume" Tapped="OnRecentSearchClicked" />
                    <controls:FilterChip Text="Tchoua" Tapped="OnRecentSearchClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Results: Clients -->
            <VerticalStackLayout Spacing="10" Padding="20, 4, 20, 0"
                                 IsVisible="{Binding ClientResults.Count, Converter={StaticResource BoolInvert}, ConverterParameter=False}">
                <Label Text="{Binding ClientResults.Count, StringFormat='Clients · {0} résultat(s)'}"
                       FontFamily="BricolageExtraBold"
                       FontSize="15"
                       TextColor="{StaticResource Muted}" />

                <BindableLayout.ItemsSource>
                    <Binding Path="ClientResults" />
                </BindableLayout.ItemsSource>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Client">
                        <controls:ClientRow Client="{Binding .}"
                                            Tapped="OnClientResultClicked" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Results: Commandes -->
            <VerticalStackLayout Spacing="10" Padding="20, 8, 20, 0"
                                 IsVisible="{Binding OrderResults.Count, Converter={StaticResource BoolInvert}, ConverterParameter=False}">
                <Label Text="{Binding OrderResults.Count, StringFormat='Commandes · {0} résultat(s)'}"
                       FontFamily="BricolageExtraBold"
                       FontSize="15"
                       TextColor="{StaticResource Muted}" />

                <BindableLayout.ItemsSource>
                    <Binding Path="OrderResults" />
                </BindableLayout.ItemsSource>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Order">
                        <controls:OrderRow Order="{Binding .}"
                                           Tapped="OnOrderResultClicked" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- État vide : Aucun résultat -->
            <controls:EmptyStateView IsVisible="{Binding HasNoResults}"
                                     Title="Aucun résultat"
                                     Description="Vérifiez l'orthographe ou essayez un autre mot-clé."
                                     ButtonText="Effacer la recherche"
                                     Command="{Binding ClearQueryCommand}"
                                     Margin="20, 20" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
