<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SweetTailor.App.Controls"
             xmlns:vm="clr-namespace:SweetTailor.Core.ViewModels;assembly=SweetTailor.Core"
             x:Class="SweetTailor.App.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             BackgroundColor="{StaticResource Chalk}"
             Title="Profil &amp; Atelier">

    <Grid RowDefinitions="*,Auto">
      <Grid Grid.Row="0" RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,16,20,30" Spacing="20">

                <!-- Header Profil -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 40"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource RoseSoft}"
                            HeightRequest="80"
                            WidthRequest="80"
                            HorizontalOptions="Center">
                        <Label Text="RN"
                               FontFamily="BricolageExtraBold"
                               FontSize="28"
                               TextColor="{StaticResource Rose}"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>
                    <Label Text="{Binding StylistName}"
                           FontFamily="BricolageExtraBold"
                           FontSize="22"
                           TextColor="{StaticResource Ink}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding WorkshopDescription}"
                           FontFamily="DMSans"
                           FontSize="14"
                           TextColor="{StaticResource Muted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Bloc Stats Atelier (3 colonnes) -->
                <Border StrokeShape="RoundRectangle 18"
                        Stroke="{StaticResource Line}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        Padding="16,14">
                    <Grid ColumnDefinitions="*,*,*">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                            <Label Text="{Binding ClientsCount}"
                                   FontFamily="BricolageExtraBold"
                                   FontSize="20"
                                   TextColor="{StaticResource Indigo}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Clients"
                                   FontFamily="DMSans"
                                   FontSize="12"
                                   TextColor="{StaticResource Muted}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <BoxView Grid.Column="0" HorizontalOptions="End" WidthRequest="1" Color="{StaticResource Mist}" HeightRequest="30" VerticalOptions="Center"/>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                            <Label Text="{Binding OrdersThisMonth}"
                                   FontFamily="BricolageExtraBold"
                                   FontSize="20"
                                   TextColor="{StaticResource Indigo}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Ce mois"
                                   FontFamily="DMSans"
                                   FontSize="12"
                                   TextColor="{StaticResource Muted}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <BoxView Grid.Column="1" HorizontalOptions="End" WidthRequest="1" Color="{StaticResource Mist}" HeightRequest="30" VerticalOptions="Center"/>

                        <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                            <Label Text="{Binding OnTimeRate}"
                                   FontFamily="BricolageExtraBold"
                                   FontSize="20"
                                   TextColor="{StaticResource Success}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="À temps"
                                   FontFamily="DMSans"
                                   FontSize="12"
                                   TextColor="{StaticResource Muted}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- PANNEAU MODE DÉMO (SOUTENANCE ORALE) -->
                <Border StrokeShape="RoundRectangle 18"
                        Stroke="{StaticResource Tape}"
                        StrokeThickness="1.5"
                        BackgroundColor="{StaticResource TapeSoft}"
                        Padding="18,16">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource Tape}"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Label Text="⚡" FontSize="13" TextColor="{StaticResource Ink}" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Panneau de Démo (Soutenance)"
                                   FontFamily="BricolageExtraBold"
                                   FontSize="16"
                                   TextColor="{StaticResource Ink}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="Basculez instantanément l'état des services mock pour présenter les scénarios au jury :"
                               FontFamily="DMSans"
                               FontSize="13"
                               TextColor="{StaticResource Ink}" />

                        <!-- Sélecteur d'état en grille -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                            <controls:AppButton Grid.Row="0" Grid.Column="0"
                                                Text="Normal"
                                                Variant="Primary"
                                                Command="{Binding SetDemoStateCommand}"
                                                CommandParameter="Normal" />
                            <controls:AppButton Grid.Row="0" Grid.Column="1"
                                                Text="Vide (Empty)"
                                                Variant="Ghost"
                                                Command="{Binding SetDemoStateCommand}"
                                                CommandParameter="Empty" />
                            <controls:AppButton Grid.Row="1" Grid.Column="0"
                                                Text="Erreur NET-01"
                                                Variant="Danger"
                                                Command="{Binding SetDemoStateCommand}"
                                                CommandParameter="Error" />
                            <controls:AppButton Grid.Row="1" Grid.Column="1"
                                                Text="Lent (5 s)"
                                                Variant="Accent"
                                                Command="{Binding SetDemoStateCommand}"
                                                CommandParameter="Slow" />
                        </Grid>

                        <controls:AppButton Text="Réinitialiser les données"
                                            Variant="Ghost"
                                            Command="{Binding ResetDemoDataCommand}" />

                        <!-- Lien direct vers Écran 24 (Charte des composants) -->
                        <controls:AppButton Text="📐 Voir la charte des composants (Écran 24)"
                                            Variant="Primary"
                                            Clicked="OnNavigateToComponentsCharterClicked" />
                    </VerticalStackLayout>
                </Border>

                <controls:AppButton Text="Revoir la présentation de l’application"
                                    Variant="Ghost"
                                    Clicked="OnNavigateToOnboardingClicked" />

                <!-- Section Coordonnées -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Coordonnées de l'atelier"
                           FontFamily="BricolageExtraBold"
                           FontSize="15"
                           TextColor="{StaticResource Ink}" />
                    <Border StrokeShape="RoundRectangle 18"
                            Stroke="{StaticResource Line}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource White}"
                            Padding="16,14">
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="✉️" FontSize="16" VerticalOptions="Center"/>
                                <Label Text="{Binding Email}"
                                       FontFamily="DMSans"
                                       FontSize="14"
                                       TextColor="{StaticResource Ink}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <BoxView HeightRequest="1" Color="{StaticResource Mist}"/>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="📞" FontSize="16" VerticalOptions="Center"/>
                                <Label Text="{Binding Phone}"
                                       FontFamily="DMSans"
                                       FontSize="14"
                                       TextColor="{StaticResource Ink}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Section Préférences -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Préférences &amp; Sauvegarde"
                           FontFamily="BricolageExtraBold"
                           FontSize="15"
                           TextColor="{StaticResource Ink}" />
                    <Border StrokeShape="RoundRectangle 18"
                            Stroke="{StaticResource Line}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource White}"
                            Padding="16,14">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Sauvegarde locale automatique"
                                           FontFamily="DMSansBold"
                                           FontSize="14"
                                           TextColor="{StaticResource Ink}"/>
                                    <Label Text="Données persistées sur le terminal"
                                           FontFamily="DMSans"
                                           FontSize="12"
                                           TextColor="{StaticResource Muted}"/>
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding AutoBackup}"
                                        OnColor="{StaticResource Indigo}"
                                        ThumbColor="{StaticResource White}"
                                        VerticalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Mist}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Rappels d'essayages"
                                           FontFamily="DMSansBold"
                                           FontSize="14"
                                           TextColor="{StaticResource Ink}"/>
                                    <Label Text="Notification 48h avant l'échéance"
                                           FontFamily="DMSans"
                                           FontSize="12"
                                           TextColor="{StaticResource Muted}"/>
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding FittingReminders}"
                                        OnColor="{StaticResource Indigo}"
                                        ThumbColor="{StaticResource White}"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Bouton Déconnexion -->
                <controls:AppButton Text="Se déconnecter"
                                    Variant="Danger"
                                    Command="{Binding LogoutCommand}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Toast Banner -->
        <controls:ToastBanner Grid.Row="1"
                              IsVisible="{Binding IsToastVisible}"
                              Message="{Binding ToastMessage}"
                              Type="{Binding ToastType}" />
      </Grid>
      <controls:BottomNavigationBar Grid.Row="1" CurrentTab="Profile" />
    </Grid>

</ContentPage>
