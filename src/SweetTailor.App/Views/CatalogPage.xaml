<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SweetTailor.App.Controls"
             xmlns:vm="clr-namespace:SweetTailor.Core.ViewModels;assembly=SweetTailor.Core"
             xmlns:models="clr-namespace:SweetTailor.Core.Models;assembly=SweetTailor.Core"
             x:Class="SweetTailor.App.Views.CatalogPage"
             x:DataType="vm:CatalogViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Chalk}">

    <Grid RowDefinitions="*,Auto">
      <ScrollView Grid.Row="0">
        <VerticalStackLayout Spacing="16" Padding="0, 10, 0, 40">
            <!-- Topbar -->
            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" Padding="20, 6, 20, 0">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{Binding ModelCountLabel}"
                           FontFamily="DMSans"
                           FontSize="13"
                           TextColor="{StaticResource Muted}" />
                    <Label Text="Catalogue"
                           FontFamily="BricolageExtraBold"
                           FontSize="28"
                           TextColor="{StaticResource Ink}" />
                </VerticalStackLayout>
                <Border x:Name="FavoritesFilterButton"
                        Grid.Column="1"
                        StrokeShape="RoundRectangle 20"
                        Stroke="{StaticResource Line}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        WidthRequest="40"
                        HeightRequest="40"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                    <Grid>
                        <Path x:Name="FavoriteFilterIcon"
                              Data="{StaticResource IconPathHeart}"
                              Stroke="{StaticResource Muted}"
                              StrokeThickness="1.8"
                              WidthRequest="20"
                              HeightRequest="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFavoritesTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 20"
                        Stroke="{StaticResource Line}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        WidthRequest="40"
                        HeightRequest="40"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                    <Label Text="+"
                           FontSize="28"
                           TextColor="{StaticResource Indigo}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,-2,0,0" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddModelTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- Search Bar -->
            <Grid Padding="20, 0">
                <controls:SearchBox Placeholder="Rechercher un modèle, un style"
                                    Text="{Binding SearchQuery, Mode=TwoWay}"
                                    SearchCommand="{Binding LoadCatalogCommand}" />
            </Grid>

            <!-- Category Chips -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="20, 0">
                <HorizontalStackLayout x:Name="AudienceFilterChips" Spacing="8">
                    <controls:FilterChip Text="Tout" IsSelected="True" Tapped="OnAudienceChipClicked" />
                    <controls:FilterChip Text="Femme" IsSelected="False" Tapped="OnAudienceChipClicked" />
                    <controls:FilterChip Text="Homme" IsSelected="False" Tapped="OnAudienceChipClicked" />
                    <controls:FilterChip Text="Enfant" IsSelected="False" Tapped="OnAudienceChipClicked" />
                </HorizontalStackLayout>
            </ScrollView>
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="20, 0">
                <HorizontalStackLayout x:Name="StyleFilterChips" Spacing="8">
                    <controls:FilterChip Text="Tout" IsSelected="True" Tapped="OnCategoryChipClicked" />
                    <controls:FilterChip Text="Robes" IsSelected="False" Tapped="OnCategoryChipClicked" />
                    <controls:FilterChip Text="Pagne" IsSelected="False" Tapped="OnCategoryChipClicked" />
                    <controls:FilterChip Text="Costumes" IsSelected="False" Tapped="OnCategoryChipClicked" />
                    <controls:FilterChip Text="Mariage" IsSelected="False" Tapped="OnCategoryChipClicked" />
                    <controls:FilterChip Text="Soirée" IsSelected="False" Tapped="OnCategoryChipClicked" />
                    <controls:FilterChip Text="Traditionnel" IsSelected="False" Tapped="OnCategoryChipClicked" />
                </HorizontalStackLayout>
            </ScrollView>

            <!-- 2-Column Staggered Cards (Pinterest Style) -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Padding="20, 4, 20, 0">
                <!-- Column 1 -->
                <VerticalStackLayout Grid.Column="0" Spacing="14">
                    <BindableLayout.ItemsSource>
                        <Binding Path="Column1Models" />
                    </BindableLayout.ItemsSource>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:CatalogModel">
                            <controls:ModelCard Model="{Binding .}"
                                                ImageHeight="{Binding CardHeight}"
                                                Tapped="OnModelCardClicked"
                                                FavoriteToggled="OnFavoriteToggled" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Column 2 -->
                <VerticalStackLayout Grid.Column="1" Spacing="14">
                    <BindableLayout.ItemsSource>
                        <Binding Path="Column2Models" />
                    </BindableLayout.ItemsSource>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:CatalogModel">
                            <controls:ModelCard Model="{Binding .}"
                                                ImageHeight="{Binding CardHeight}"
                                                Tapped="OnModelCardClicked"
                                                FavoriteToggled="OnFavoriteToggled" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
      </ScrollView>
      <controls:BottomNavigationBar Grid.Row="1" CurrentTab="Catalog" />
    </Grid>

</ContentPage>
