<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SweetTailor.App.Controls"
             xmlns:vm="clr-namespace:SweetTailor.Core.ViewModels;assembly=SweetTailor.Core"
             x:Class="SweetTailor.App.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Chalk}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20, 16, 20, 30" Spacing="20">
                <!-- Top Navigation Bar -->
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Border StrokeShape="RoundRectangle 20"
                            Stroke="{StaticResource Line}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource White}"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Border.GestureRecognizers>
                        <Path Data="{StaticResource IconPathBack}"
                              Stroke="{StaticResource Ink}"
                              StrokeThickness="1.8"
                              WidthRequest="20"
                              HeightRequest="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="Récupération" FontFamily="DMSansBold" FontSize="15" TextColor="{StaticResource Muted}" HorizontalOptions="Center" VerticalOptions="Center" />
                    <BoxView Grid.Column="2" WidthRequest="40" HeightRequest="40" Color="Transparent" />
                </Grid>

                <!-- Lock Illustration & Header -->
                <VerticalStackLayout Spacing="16" Margin="0, 16, 0, 0">
                    <Border WidthRequest="72" HeightRequest="72"
                            StrokeShape="RoundRectangle 24"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource RoseSoft}"
                            HorizontalOptions="Start">
                        <Label Text="🔒" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Mot de passe oublié ?"
                               FontFamily="BricolageExtraBold"
                               FontSize="28"
                               TextColor="{StaticResource Ink}" />
                        <Label Text="Entrez votre e-mail ou votre téléphone. Nous vous enverrons un code pour choisir un nouveau mot de passe."
                               FontFamily="DMSans"
                               FontSize="14"
                               TextColor="{StaticResource Muted}"
                               LineHeight="1.5" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Input Field -->
                <controls:AppEntry Label="E-mail ou téléphone"
                                   Text="{Binding Identifier, Mode=TwoWay}"
                                   Placeholder="nom@exemple.com"
                                   LeadingIcon="mail"
                                   Keyboard="Email"
                                   Margin="0, 10, 0, 0" />

                <!-- Action Button -->
                <controls:AppButton Text="Envoyer le code"
                                    Variant="Primary"
                                    IsBusy="{Binding IsBusy}"
                                    Command="{Binding SendCodeCommand}" />

                <!-- Success Box if code sent -->
                <Border IsVisible="{Binding CodeSent}"
                        StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource Success}"
                        BackgroundColor="{StaticResource SuccessSoft}"
                        Padding="16, 12">
                    <Label Text="Un code à 6 chiffres a été envoyé par SMS/E-mail. Vérifiez votre boîte de réception !"
                           FontFamily="DMSans"
                           FontSize="13"
                           TextColor="{StaticResource Success}" />
                </Border>

                <!-- Footer -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0, 20, 0, 0">
                    <Label Text="Vous vous souvenez ?" FontFamily="DMSans" FontSize="14" TextColor="{StaticResource Muted}" />
                    <Label Text="Retour à la connexion"
                           FontFamily="DMSansBold"
                           FontSize="14"
                           TextColor="{StaticResource Indigo}"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Toast Banner -->
        <controls:ToastBanner Grid.Row="1"
                              IsVisible="{Binding IsToastVisible}"
                              Message="{Binding ToastMessage}"
                              Type="{Binding ToastType}" />
    </Grid>

</ContentPage>
