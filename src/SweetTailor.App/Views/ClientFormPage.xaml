<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SweetTailor.App.Controls"
             xmlns:vm="clr-namespace:SweetTailor.Core.ViewModels;assembly=SweetTailor.Core"
             x:Class="SweetTailor.App.Views.ClientFormPage"
             x:DataType="vm:ClientFormViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Chalk}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20, 10, 20, 30" Spacing="20">
                <!-- Topbar -->
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 20"
                            Stroke="{StaticResource Line}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource White}"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="✕" FontSize="16" TextColor="{StaticResource Ink}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="{Binding FormTitle}" FontFamily="BricolageExtraBold" FontSize="17" TextColor="{StaticResource Ink}" HorizontalOptions="Center" VerticalOptions="Center" />
                    <BoxView Grid.Column="2" WidthRequest="40" HeightRequest="40" Color="Transparent" />
                </Grid>

                <!-- Avatar Placeholder with Camera Badge -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPickClientPhotoTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Grid WidthRequest="92" HeightRequest="92">
                        <Border WidthRequest="92" HeightRequest="92"
                                StrokeShape="RoundRectangle 46"
                                Stroke="#C9CCEA"
                                StrokeThickness="2"
                                StrokeDashArray="3, 3"
                                BackgroundColor="{StaticResource White}">
                            <Grid>
                                <Image Source="{Binding PhotoPath}"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding HasPhoto}" />
                                <Path Data="{StaticResource IconPathUser}"
                                      Stroke="{StaticResource Muted}"
                                      StrokeThickness="1.6"
                                      WidthRequest="38"
                                      HeightRequest="38"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      IsVisible="{Binding HasPhoto, Converter={StaticResource BoolInvert}}" />
                            </Grid>
                        </Border>
                        <!-- Camera Badge -->
                        <Border WidthRequest="32" HeightRequest="32"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="2"
                                Stroke="{StaticResource Chalk}"
                                BackgroundColor="{StaticResource Rose}"
                                HorizontalOptions="End"
                                VerticalOptions="End">
                            <Path Data="{StaticResource IconPathCamera}"
                                  Stroke="{StaticResource White}"
                                  StrokeThickness="1.8"
                                  WidthRequest="18"
                                  HeightRequest="18"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Label Text="Ajouter une photo (facultatif)" FontFamily="DMSans" FontSize="12" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Form Fields -->
                <VerticalStackLayout Spacing="14">
                    <controls:AppEntry Label="Nom complet"
                                       Text="{Binding FullName, Mode=TwoWay}"
                                       Placeholder="Ex : Nadège Mbarga"
                                       LeadingIcon="user"
                                       IsValid="{Binding IsFullNameValid}"
                                       ErrorMessage="{Binding FullNameError}" />

                    <controls:AppEntry Label="Téléphone"
                                       Text="{Binding PhoneNumber, Mode=TwoWay}"
                                       Placeholder="+237 6 77 00 00 00"
                                       LeadingIcon="phone"
                                       Keyboard="Telephone"
                                       IsValid="{Binding IsPhoneNumberValid}"
                                       ErrorMessage="{Binding PhoneNumberError}" />

                    <controls:AppEntry Label="Quartier ou adresse"
                                       Text="{Binding Address, Mode=TwoWay}"
                                       Placeholder="Ex : Bonamoussadi, Douala" />

                    <!-- Catégorie avec SegmentedTabs -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Catégorie" FontFamily="DMSansBold" FontSize="13" TextColor="{StaticResource Muted}" />
                        <controls:SegmentedTabs Tabs="Femme,Homme,Enfant"
                                                SelectedTab="{Binding CategoryTab, Mode=TwoWay}"
                                                TabChanged="OnCategoryChanged" />
                    </VerticalStackLayout>

                    <!-- Note facultative -->
                    <controls:AppEntry Label="Note (facultatif)"
                                       Text="{Binding Note, Mode=TwoWay}"
                                       Placeholder="Ex. : préfère les coupes ajustées" />
                </VerticalStackLayout>

                <!-- Actions -->
                <VerticalStackLayout Spacing="10" Margin="0, 10, 0, 0">
                    <controls:AppButton Text="Enregistrer et saisir les mesures"
                                        Variant="Accent"
                                        Clicked="OnSaveAndAddMeasurementsClicked"
                                        IsVisible="{Binding IsNewClient}" />

                    <controls:AppButton Text="{Binding SaveButtonText}"
                                        Variant="Ghost"
                                        Clicked="OnSaveOnlyClicked" />

                    <controls:AppButton Text="Supprimer ce client"
                                        Variant="Danger"
                                        Clicked="OnDeleteClientClicked"
                                        IsVisible="{Binding IsEditing}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Toast Banner -->
        <controls:ToastBanner Grid.Row="1"
                              IsVisible="{Binding IsToastVisible}"
                              Message="{Binding ToastMessage}"
                              Type="{Binding ToastType}" />
    </Grid>

</ContentPage>
