<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SweetTailor.App.Controls"
             xmlns:vm="clr-namespace:SweetTailor.Core.ViewModels;assembly=SweetTailor.Core"
             xmlns:models="clr-namespace:SweetTailor.Core.Models;assembly=SweetTailor.Core"
             x:Class="SweetTailor.App.Views.CatalogDetailPage"
             x:DataType="vm:CatalogDetailViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Chalk}">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Topbar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20, 10, 20, 10">
            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 20"
                    Stroke="{StaticResource Line}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource White}"
                    WidthRequest="40"
                    HeightRequest="40"
                    HorizontalOptions="Start">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Path Data="{StaticResource IconPathBack}"
                      Stroke="{StaticResource Ink}"
                      StrokeThickness="1.8"
                      WidthRequest="20"
                      HeightRequest="20"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Border>
            <Border Grid.Column="2"
                    StrokeShape="RoundRectangle 20"
                    Stroke="{StaticResource Line}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource White}"
                    WidthRequest="40"
                    HeightRequest="40"
                    HorizontalOptions="End">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnShareTapped" />
                </Border.GestureRecognizers>
                <Path Data="{StaticResource IconPathShare}"
                      Stroke="{StaticResource Muted}"
                      StrokeThickness="1.8"
                      WidthRequest="20"
                      HeightRequest="20"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Scrollable Details -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="20, 4, 20, 20">
                <!-- Big Hero Model Visual -->
                <Border HeightRequest="216"
                        StrokeShape="RoundRectangle 28"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource RoseSoft}">
                    <Grid>
                        <Image Source="{Binding Model.ImagePath}"
                               Aspect="AspectFill"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />

                        <!-- Category Badge Bottom Left -->
                        <Border StrokeShape="RoundRectangle 999"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource White}"
                                Padding="12, 6"
                                HorizontalOptions="Start"
                                VerticalOptions="End"
                                Margin="14">
                            <Label Text="{Binding Model.Category}" FontFamily="DMSansBold" FontSize="12" TextColor="{StaticResource Indigo}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Titles -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding Model.Title}"
                           FontFamily="BricolageExtraBold"
                           FontSize="24"
                           TextColor="{StaticResource Ink}" />
                    <Label Text="{Binding Model.Subtitle}"
                           FontFamily="DMSans"
                           FontSize="14"
                           TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>

                <!-- Section: Mesures à prendre -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Mesures à prendre"
                           FontFamily="BricolageExtraBold"
                           FontSize="15"
                           TextColor="{StaticResource Muted}" />
                    <FlexLayout Wrap="Wrap">
                        <BindableLayout.ItemsSource>
                            <Binding Path="Model.RequiredMeasurements" />
                        </BindableLayout.ItemsSource>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border BackgroundColor="{StaticResource White}"
                                        Stroke="{StaticResource Line}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 999"
                                        Padding="12, 6"
                                        Margin="0, 0, 8, 8">
                                    <Label Text="{Binding}" FontFamily="DMSansBold" FontSize="12" TextColor="{StaticResource Ink}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Section: Modèles similaires -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Modèles similaires"
                           FontFamily="BricolageExtraBold"
                           FontSize="15"
                           TextColor="{StaticResource Muted}" />
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                        <BindableLayout.ItemsSource>
                            <Binding Path="SimilarModels" />
                        </BindableLayout.ItemsSource>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CatalogModel">
                                <Border HeightRequest="84" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="{StaticResource Mist}">
                                    <Path Data="{Binding SvgAsset, Converter={StaticResource GarmentGeometry}}"
                                          Fill="{Binding SvgFillColor}"
                                          WidthRequest="40"
                                          HeightRequest="60"
                                          Aspect="Uniform"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto, *" ColumnSpacing="12" Padding="20, 10, 20, 24">
            <!-- Favorite Heart Button -->
            <Border Grid.Column="0"
                    WidthRequest="52"
                    HeightRequest="52"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1"
                    Stroke="{StaticResource Line}"
                    BackgroundColor="{StaticResource White}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                </Border.GestureRecognizers>
                <Path Data="{StaticResource IconPathHeart}"
                      Fill="{Binding Model.IsFavorite, Converter={StaticResource HeartFill}}"
                      Stroke="{Binding Model.IsFavorite, Converter={StaticResource HeartStroke}}"
                      StrokeThickness="1.8"
                      WidthRequest="22"
                      HeightRequest="22"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Border>

            <!-- Create Order Button in Accent Rose -->
            <controls:AppButton Grid.Column="1"
                                Text="Créer une commande"
                                Variant="Accent"
                                Clicked="OnCreateOrderClicked" />
        </Grid>
    </Grid>

</ContentPage>
