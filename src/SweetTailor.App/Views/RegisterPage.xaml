<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SweetTailor.App.Controls"
             xmlns:vm="clr-namespace:SweetTailor.Core.ViewModels;assembly=SweetTailor.Core"
             x:Class="SweetTailor.App.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Chalk}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20, 16, 20, 30" Spacing="20">
                <!-- Top Navigation Bar -->
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Border StrokeShape="RoundRectangle 20"
                            Stroke="{StaticResource Line}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource White}"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Border.GestureRecognizers>
                        <Path Data="{StaticResource IconPathBack}"
                              Stroke="{StaticResource Ink}"
                              StrokeThickness="1.8"
                              WidthRequest="20"
                              HeightRequest="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="Inscription" FontFamily="DMSansBold" FontSize="15" TextColor="{StaticResource Muted}" HorizontalOptions="Center" VerticalOptions="Center" />
                    <BoxView Grid.Column="2" WidthRequest="40" HeightRequest="40" Color="Transparent" />
                </Grid>

                <!-- Title Header -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Créer un compte"
                           FontFamily="BricolageExtraBold"
                           FontSize="28"
                           TextColor="{StaticResource Ink}" />
                    <Label Text="Quelques infos pour ouvrir votre carnet d'atelier."
                           FontFamily="DMSans"
                           FontSize="14"
                           TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>

                <!-- Form Validation Fields -->
                <VerticalStackLayout Spacing="14">
                    <!-- Nom complet -->
                    <controls:AppEntry Label="Nom complet"
                                       Text="{Binding FullName, Mode=TwoWay}"
                                       Placeholder="Ex: Rose Ndongo"
                                       LeadingIcon="user"
                                       IsValid="{Binding IsFullNameValid}" />

                    <!-- Téléphone -->
                    <controls:AppEntry Label="Téléphone"
                                       Text="{Binding Phone, Mode=TwoWay}"
                                       Placeholder="+237 6 77 00 00 00"
                                       LeadingIcon="phone"
                                       Keyboard="Telephone"
                                       IsValid="{Binding IsPhoneValid}" />

                    <!-- E-mail -->
                    <controls:AppEntry Label="E-mail"
                                       Text="{Binding Email, Mode=TwoWay}"
                                       Placeholder="nom@exemple.com"
                                       LeadingIcon="mail"
                                       Keyboard="Email"
                                       IsValid="{Binding IsEmailValid}"
                                       ErrorMessage="{Binding DisplayEmailError}" />

                    <!-- Mot de passe -->
                    <controls:AppEntry Label="Mot de passe"
                                       Text="{Binding Password, Mode=TwoWay}"
                                       Placeholder="••••••••"
                                       IsPassword="True"
                                       LeadingIcon="lock"
                                       HelperText="{Binding PasswordHint}"
                                       IsValid="{Binding IsPasswordValid}" />

                    <!-- Confirmer le mot de passe -->
                    <controls:AppEntry Label="Confirmer le mot de passe"
                                       Text="{Binding ConfirmPassword, Mode=TwoWay}"
                                       Placeholder="••••••••"
                                       IsPassword="True"
                                       LeadingIcon="lock"
                                       IsValid="{Binding IsConfirmPasswordValid}"
                                       ErrorMessage="{Binding DisplayConfirmPasswordError}" />
                </VerticalStackLayout>

                <!-- Conditions d'utilisation -->
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <CheckBox IsChecked="{Binding AcceptTerms, Mode=TwoWay}"
                              Color="{StaticResource Indigo}" />
                    <Label VerticalOptions="Center" FontFamily="DMSans" FontSize="13" TextColor="{StaticResource Ink}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="J'accepte les " />
                                <Span Text="conditions d'utilisation" FontAttributes="Bold" TextColor="{StaticResource Indigo}" TextDecorations="Underline" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </HorizontalStackLayout>

                <!-- Submit CTA -->
                <controls:AppButton Text="Créer mon compte"
                                    Variant="Primary"
                                    IsEnabled="{Binding CanSubmit}"
                                    IsBusy="{Binding IsBusy}"
                                    Command="{Binding RegisterCommand}" />

                <!-- Footer: Switch to Login -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0, 10, 0, 0">
                    <Label Text="Déjà un compte ?" FontFamily="DMSans" FontSize="14" TextColor="{StaticResource Muted}" />
                    <Label Text="Se connecter"
                           FontFamily="DMSansBold"
                           FontSize="14"
                           TextColor="{StaticResource Indigo}"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Toast Banner -->
        <controls:ToastBanner Grid.Row="1"
                              IsVisible="{Binding IsToastVisible}"
                              Message="{Binding ToastMessage}"
                              Type="{Binding ToastType}" />
    </Grid>

</ContentPage>
