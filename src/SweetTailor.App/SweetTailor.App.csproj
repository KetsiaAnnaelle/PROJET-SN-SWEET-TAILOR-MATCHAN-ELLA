<Project Sdk="Microsoft.NET.Sdk">

	<!-- Mobile MAUI Configuration (Active when BuildingForMobile is true, or in Visual Studio with workloads) -->
	<PropertyGroup Condition="'$(BuildingForMobile)' == 'true'">
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>SweetTailor.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name and identifiers -->
		<ApplicationTitle>Sweet Tailor</ApplicationTitle>
		<ApplicationId>com.sweettailor.app</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(BuildingForDesktop)' == 'true'">
		<TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>WinExe</OutputType>
		<RootNamespace>SweetTailor.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>

		<ApplicationTitle>Sweet Tailor</ApplicationTitle>
		<ApplicationId>com.sweettailor.app</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Default configuration for solution builds without MAUI workloads -->
	<PropertyGroup Condition="'$(BuildingForMobile)' != 'true' and '$(BuildingForDesktop)' != 'true'">
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>SweetTailor.App</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- When not building for mobile, exclude MAUI-dependent sources from compilation to allow standard CLI build without workloads -->
	<ItemGroup Condition="'$(BuildingForMobile)' != 'true' and '$(BuildingForDesktop)' != 'true'">
		<Compile Remove="**\*.cs" />
		<None Include="**\*.cs" />
		<None Include="**\*.xaml" />
	</ItemGroup>

	<ItemGroup Condition="'$(BuildingForMobile)' == 'true' or '$(BuildingForDesktop)' == 'true'">
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#26306B" BaseSize="128,128" />

		<!-- Raw Assets (fonts, images) -->
		<MauiFont Include="Resources\Fonts\*" />
		<MauiImage Include="Resources\Images\*" />

		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="TesseractOcrMaui" Version="1.5.2" />
		<ProjectReference Include="..\SweetTailor.Core\SweetTailor.Core.csproj" />
	</ItemGroup>

</Project>
